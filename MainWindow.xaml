<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://microsoft.com"
        xmlns:x="http://microsoft.com"
        Title="Wetter-App" Height="500" Width="400"
        Background="#1E1E1E" Foreground="White"
        WindowStartupLocation="CenterScreen">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Suchbereich -->
            <RowDefinition Height="*"/>    <!-- Wetterdaten-Anzeige -->
        </Grid.RowDefinitions>

        <!-- Suchbereich (Stadtname und Suchen-Button) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBox x:Name="CityInput" Width="220" Height="35" 
                     VerticalContentAlignment="Center" Padding="10,0"
                     Background="#2D2D2D" Foreground="White" BorderBrush="#3D3D3D"
                     FontSize="14"/>
            <Button x:Name="SearchButton" Content="Suchen" Width="80" Height="35" Margin="10,0,0,0"
                    Background="#007ACC" Foreground="White" BorderThickness="0"
                    FontSize="14" FontWeight="Bold" Click="SearchButton_Click"/>
        </StackPanel>

        <!-- Wetterdaten-Anzeige (Wird aktualisiert, sobald eine Stadt gesucht wird) -->
        <StackPanel Grid.Row="1" x:Name="WeatherDisplayBlock" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="CityNameText" Text="Berlin" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#007ACC"/>
            <TextBlock x:Name="TemperatureText" Text="18°C" FontSize="64" FontWeight="Light" HorizontalAlignment="Center" Margin="0,10"/>
            <TextBlock x:Name="DescriptionText" Text="Leicht bewölkt" FontSize="18" HorizontalAlignment="Center" Foreground="#AAAAAA"/>
            
            <!-- Zusätzliche Wetterdetails -->
            <UniformGrid Columns="2" Margin="0,30,0,0" Width="300">
                <StackPanel Margin="10">
                    <TextBlock Text="Feuchtigkeit" Foreground="#888888" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="HumidityText" Text="65%" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Margin="10">
                    <TextBlock Text="Wind" Foreground="#888888" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="WindText" Text="4.5 m/s" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
