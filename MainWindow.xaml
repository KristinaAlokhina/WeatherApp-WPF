<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wetter-App" Height="500" Width="400"
        Background="#1E1E1E" Foreground="White"
        WindowStartupLocation="CenterScreen">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Блок поиска города -->
		<StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
			<TextBox x:Name="CityInput" Width="220" Height="35"
                     VerticalContentAlignment="Center" Padding="10,0"
                     Background="#2D2D2D" Foreground="White" BorderBrush="#3D3D3D"
                     FontSize="14"/>
			<Button x:Name="SearchButton" Content="Suchen" Width="80" Height="35" Margin="10,0,0,0"
                    Background="#007ACC" Foreground="White" BorderThickness="0"
                    FontSize="14" FontWeight="Bold" Click="SearchButton_Click"/>
		</StackPanel>

		<!-- Блок вывода погоды на экран -->
		<StackPanel Grid.Row="1" x:Name="WeatherDisplayBlock" VerticalAlignment="Center" HorizontalAlignment="Center">
			<TextBlock x:Name="CityNameText" Text="Stadt" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#007ACC"/>
			<TextBlock x:Name="TemperatureText" Text="--°C" FontSize="64" FontWeight="Light" HorizontalAlignment="Center" Margin="0,10"/>
			<TextBlock x:Name="DescriptionText" Text="Wetterzustand" FontSize="18" HorizontalAlignment="Center" Foreground="#AAAAAA"/>

			<!-- Дополнительные параметры (Влажность и Ветер) -->
			<UniformGrid Columns="2" Margin="0,30,0,0" Width="300">
				<StackPanel Margin="10">
					<TextBlock Text="Feuchtigkeit" Foreground="#888888" HorizontalAlignment="Center"/>
					<TextBlock x:Name="HumidityText" Text="--%" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
				</StackPanel>
				<StackPanel Margin="10">
					<TextBlock Text="Wind" Foreground="#888888" HorizontalAlignment="Center"/>
					<TextBlock x:Name="WindText" Text="-- m/s" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
				</StackPanel>
			</UniformGrid>
		</StackPanel>
	</Grid>
</Window>
